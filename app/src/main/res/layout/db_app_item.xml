<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/db_app_item_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="8dp"
    android:clipChildren="false">

    <!-- 图标容器 -->
    <FrameLayout
        android:id="@+id/db_app_icon_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center">

        <!-- 聚焦边框 -->
        <View
            android:id="@+id/db_app_focus_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/db_app_focus_bg"
            android:visibility="invisible" />

        <!-- 应用图标 -->
        <ImageView
            android:id="@+id/db_app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- 应用名称 -->
    <TextView
        android:id="@+id/db_app_name"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/db_white"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
